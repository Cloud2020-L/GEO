# Production environment template. Copy to .env.production on the server and fill real values there.
# Never commit .env.production.
# Template only. Fill real values in local .env files; do not commit real secrets.
POSTGRES_DSN=postgresql://user:password@host:5432/database
QDRANT_URL=https://example.com
QDRANT_COLLECTION=your_name_here
AI_SERVICE_PORT=8010
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=180
FORWARDED_ALLOW_IPS=your_forwarded_allow_ips_here
CLIENT_CREDIT_EXPIRY_SECONDS=31536000

JWT_SECRET=replace_with_strong_secret
JWT_EXPIRE_MINUTES=1
CORS_ALLOW_ORIGINS=https://your-domain.example
ENABLE_HTTPS_REDIRECT=false

TASK_QUEUE_BACKEND=your_task_queue_backend_here
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_REDIS_QUEUE=your_name_here
TASK_QUEUE_JOB_TIMEOUT=3600
TASK_QUEUE_RESULT_TTL=86400
TASK_QUEUE_FAILURE_TTL=604800
LOCAL_TASK_QUEUE_WORKERS=1

MODEL_DEFAULT_PROVIDER=your_model_or_provider
MODEL_GATEWAY_TIMEOUT=60
MODEL_GATEWAY_RETRY_ATTEMPTS=2
MODEL_GATEWAY_TRUST_ENV=false

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_model_or_provider

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://example.com
DEEPSEEK_MODEL=your_model_or_provider

MOONSHOT_API_KEY=your_moonshot_api_key_here
MOONSHOT_BASE_URL=https://example.com
MOONSHOT_MODEL=your_model_or_provider

ARK_API_KEY=your_ark_api_key_here
DOUBAO_BASE_URL=https://example.com
DOUBAO_MODEL=your_model_or_provider

DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://example.com
QWEN_MODEL=your_model_or_provider

HUNYUAN_API_KEY=your_hunyuan_api_key_here
HUNYUAN_BASE_URL=https://example.com
HUNYUAN_MODEL=your_model_or_provider

QIANFAN_API_KEY=your_qianfan_api_key_here
QIANFAN_BASE_URL=https://example.com
QIANFAN_MODEL=your_model_or_provider

ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://example.com
ZHIPU_MODEL=your_model_or_provider

SPARK_APP_ID=your_spark_app_id_here
SPARK_API_KEY=your_spark_api_key_here
SPARK_API_SECRET=replace_with_strong_secret
SPARK_BASE_URL=https://example.com
SPARK_WS_URL=https://example.com
SPARK_MODEL=your_model_or_provider

MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://example.com
MINIMAX_MODEL=your_model_or_provider

ZHINAO_API_KEY=your_zhinao_api_key_here
ZHINAO_BASE_URL=https://example.com
ZHINAO_MODEL=your_model_or_provider

BAICHUAN_API_KEY=your_baichuan_api_key_here
BAICHUAN_BASE_URL=https://example.com
BAICHUAN_MODEL=your_model_or_provider

YUNWU_API_KEY=your_yunwu_api_key_here
YUNWU_BASE_URL=https://example.com
YUNWU_MODEL=your_model_or_provider

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://example.com
GEMINI_MODEL=your_model_or_provider

MEDIA_MARKET_BASE_URL=https://example.com
MEDIA_MARKET_USERNAME=your_username_here
MEDIA_MARKET_PWD=your_password_here
MEDIA_MARKET_CODE=your_media_market_code_here
MEDIA_MARKET_FILE_BASE_URL=https://example.com/file
MEDIA_MARKET_TRUST_ENV=false

# 短信验证码。生产建议设置为 tencent，并填入腾讯云短信控制台审核通过的应用、签名和模板。
SMS_PROVIDER=tencent
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_PER_PHONE_PER_HOUR=5
SMS_CODE_MAX_PER_IP_PER_HOUR=20

TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id_here
TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key_here
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=1400000000
TENCENT_SMS_SIGN_NAME=your_approved_sms_sign_name_here
TENCENT_SMS_TEMPLATE_ID=your_approved_template_id_here

# ---- 生产监控与告警 ----
ALERT_WINDOW_MINUTES=60
ALERT_MODEL_FAILURE_COUNT=60
ALERT_MODEL_FAILURE_RATE=0.5
ALERT_TASK_FAILURE_COUNT=60
ALERT_TASK_FAILURE_RATE=0.5
ALERT_QUEUE_BACKLOG_THRESHOLD=60
ALERT_CLIENT_ERROR_COUNT=60
ALERT_WEBHOOK_URL=https://example.com
