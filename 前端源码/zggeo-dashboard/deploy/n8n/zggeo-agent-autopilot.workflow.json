    {
      "parameters": {
        "method": "POST",
        "url": "=http://ai-service:8010/agent/workflows/{{$json.id}}/n8n-callback",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "step_key",
              "value": "recheck"
            },
            {
              "name": "status",
              "value": "={{ ($json.steps || []).find((step) => step.step_key === 'recheck')?.status || $json.status || 'completed' }}"
            },
            {
              "name": "detail",
              "value": "={{ $json.summary || 'n8n 节点回调：已确认 ZGEO 巡检结果。' }}"
            },
            {
              "name": "payload",
              "value": "={{ { source: 'n8n-agent-autopilot', node: '回调 ZGEO：巡检结果确认', event: 'inspection_confirmed', run_id: $json.id, project_name: $json.project_name, domain: $json.domain, workflow_status: $json.status, last_inspection: $json.last_inspection || null } }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "e59b0058-52fa-4e74-96f2-ea0bd592426a",
      "name": "回调 ZGEO：巡检结果确认",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        180
