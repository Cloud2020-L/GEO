              "name": "workflow_id",
              "value": "zggeo-agent-autopilot"
            },
            {
              "name": "workflow_name",
              "value": "ZGEO Agent 自动运作 - 定时巡检与节点回调"
            },
            {
              "name": "node_name",
              "value": "回调 ZGEO：巡检结果确认"
            },
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "detail",
              "value": "={{ '结果回调已写回 ZGEO：' + ($json.project_name || '-') }}"
            },
            {
              "name": "payload",
              "value": "={{ { source: 'n8n-agent-autopilot', run_id: $json.id, project_name: $json.project_name, domain: $json.domain, n8n_status: $json.n8n_status } }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "6fbf51be-38e6-448d-8aac-8f97bc7557f8",
      "name": "回调 n8n：结果回写完成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        180
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
