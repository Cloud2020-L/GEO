            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "detail",
              "value": "={{ '已读取客户项目状态：' + ($json.project_name || '-') + ' / ' + ($json.status || '-') }}"
            },
            {
              "name": "payload",
              "value": "={{ { source: 'n8n-agent-autopilot', run_id: $json.id, project_name: $json.project_name, domain: $json.domain, workflow_status: $json.status, recheck_status: ($json.steps || []).find((step) => step.step_key === 'recheck')?.status || null } }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "9f6d9f3a-6ee2-4c68-9461-e4c0aefb9612",
      "name": "回调 n8n：状态读取完成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        20
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
