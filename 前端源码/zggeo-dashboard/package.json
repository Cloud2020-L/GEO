{
  "name": "@tencent/tdesign-react-starter",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev:mock": "vite --open --mode mock",
    "dev": "vite --open --mode development",
    "dev:admin": "vite --open --mode admin --port 3003",
    "dev:client": "vite --open --mode client --port 3004",
    "dev:linux": "vite --mode development",
    "build:test": "vite build --mode test",
    "build": "vite build --mode release",
    "build:admin": "vite build --mode admin",
    "build:client": "vite build --mode client",
    "build:site": "vite build --mode site",
    "clean": "node scripts/clean-generated.mjs",
    "postbuild": "node scripts/compress-dist.mjs",
    "postbuild:test": "node scripts/compress-dist.mjs",
    "postbuild:site": "node scripts/compress-dist.mjs",
    "site:preview": "npm run build && cp -r dist _site",
    "preview": "vite preview --mode test",
    "preview:admin": "vite preview --mode admin --outDir dist-admin --port 3003",
    "preview:client": "vite preview --mode client --outDir dist-client --port 3004",
    "serve:prod": "vite preview --mode release --port 3003 --host 0.0.0.0",
    "test": "echo \"no test specified,work in process\"",
    "test:coverage": "echo \"no test specified,work in process\"",
    "lint": "eslint ./src --ext ts,tsx --quiet",
    "lint:all": "eslint ./src --ext ts,tsx",
    "lint:fix": "eslint ./src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,less,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,less,css,json,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run format:check && npm run typecheck",
    "verify:build": "npm run verify && npm run build:admin && npm run build:client",
    "prepare": "cd ../.. && husky install 前端源码/zggeo-dashboard/.husky"
  },
  "devDependencies": {
    "@honkhonk/vite-plugin-svgr": "^1.1.0",
    "@types/echarts": "^4.9.13",
    "@types/lodash": "^4.14.178",
    "@types/mockjs": "^1.0.6",
    "@types/node": "^20.2.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^1.3.2",
    "eslint": "^8.3.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.4.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.1",
    "less": "^4.1.3",
    "prettier": "^2.5.1",
    "typescript": "^4.8.4",
    "vite": "^2.9.15",
    "vite-plugin-mock": "^2.9.6"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.5",
    "axios": "^1.2.0",
    "axios-jsonp": "^1.0.4",
    "classnames": "^2.3.1",
    "dayjs": "^1.10.7",
    "echarts": "^5.3.0",
    "echarts-for-react": "^3.0.2",
    "lodash": "^4.17.21",
    "mockjs": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^7.2.4",
    "react-router-dom": "^6.3.0",
    "tdesign-icons-react": "^0.6.0",
    "tdesign-react": "^1.15.0",
    "tvision-color": "^1.5.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
